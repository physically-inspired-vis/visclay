# Simulation backend. Injected at build time from the VITE_SERVER repo secret.
# Left empty here on purpose - never commit a real tunnel URL to a public repo.
VITE_SERVER=

# Study data collection (Supabase). Injected from repo secrets at build time.
# If left empty, "Submit my work" downloads a JSON file instead of uploading.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
